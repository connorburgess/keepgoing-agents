{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/connorburgess/keepgoing-agents/schema/keepgoing.schema.json",
  "title": "keepgoing.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "loop"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "loop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "state_dir",
        "adapter"
      ],
      "properties": {
        "adapter": {
          "enum": [
            "bb",
            "process",
            "claude",
            "codex",
            "cursor"
          ]
        },
        "provider": {
          "type": "string",
          "description": "claude-code, codex, or any label; redundancy counts by it"
        },
        "group": {
          "type": "string",
          "description": "account or quota pool; defaults to provider"
        },
        "bb": {
          "$ref": "#/$defs/bb"
        },
        "process": {
          "$ref": "#/$defs/process"
        },
        "claude": {
          "$ref": "#/$defs/claude"
        },
        "codex": {
          "$ref": "#/$defs/codex"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "state_dir": {
          "type": "string"
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "no_progress_timeout": {"$ref": "#/$defs/duration"},
            "max_sends": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
            "deadline": {
              "type": "string",
              "anyOf": [{"format": "date-time"}, {"const": ""}],
              "description": "RFC3339 cutoff; the next check persists an awaiting-user hold. Does not cancel running turns."
            }
          }
        },
        "prompt": {
          "type": "string"
        },
        "prompt_file": {
          "type": "string"
        },
        "prompt_goal": {
          "type": "boolean",
          "description": "Explicitly include the latest private goal revision in automatic prompts and handoff briefs. Missing or invalid goals prevent sending."
        },
        "handoff_file": {
          "type": "string"
        },
        "progress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repositories": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "stall_after": {
              "$ref": "#/$defs/duration"
            },
            "min_wake_interval": {
              "$ref": "#/$defs/duration"
            },
            "max_nudges": {
              "type": "integer",
              "minimum": 1,
              "default": 3,
              "description": "nudges a stalled session gets before the loop asks a person"
            }
          }
        },
        "window": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tz",
            "days"
          ],
          "properties": {
            "tz": {
              "type": "string"
            },
            "days": {
              "type": "object",
              "additionalProperties": false,
              "patternProperties": {
                "^(Mon|Tue|Wed|Thu|Fri|Sat|Sun)$": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                  },
                  "minItems": 2,
                  "maxItems": 2
                }
              }
            }
          }
        },
        "errors": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_reprompts": {
              "type": "integer",
              "minimum": 1
            },
            "backoff": {
              "$ref": "#/$defs/duration"
            },
            "failover_on": {
              "type": "array",
              "items": {
                "enum": [
                  "rate_limit",
                  "auth",
                  "overloaded",
                  "network"
                ]
              }
            },
            "wait_if_reset_within": {
              "$ref": "#/$defs/duration"
            },
            "report_wait_after": {
              "$ref": "#/$defs/duration",
              "description": "report once when a limit wait with no possible handoff has a reset further away than this (default 6h)"
            }
          }
        },
        "fallbacks": {
          "type": "string",
          "description": "path to fallbacks.yaml"
        },
        "report": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url_env": {
              "type": "string",
              "default": "KEEPGOING_WEBHOOK_URL"
            },
            "secret_env": {
              "type": "string",
              "default": "KEEPGOING_WEBHOOK_SECRET"
            },
            "secret_file": {
              "type": "string"
            },
            "source": {
              "type": "string"
            },
            "scheme": {
              "enum": [
                "standard-webhooks",
                "bearer"
              ]
            },
            "format": {
              "enum": [
                "standard",
                "text"
              ]
            },
            "events": {
              "type": "array",
              "items": {
                "enum": [
                  "all",
                  "wake",
                  "nudge",
                  "reprompt",
                  "handoff",
                  "degraded",
                  "recovered",
                  "await_user",
                  "complete",
                  "stop",
                  "error",
                  "probe_failed",
                  "switch_back",
                  "limit_wait",
                  "child_error",
                  "test"
                ]
              }
            },
            "timeout": {
              "$ref": "#/$defs/duration"
            }
          }
        },
        "yield": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "busy_command"
          ],
          "properties": {
            "busy_command": {
              "$ref": "#/$defs/argv"
            },
            "timeout": {
              "$ref": "#/$defs/duration"
            }
          }
        },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "description": "connectivity check made before an error re-prompt, a handoff and fallback probes",
          "properties": {
            "check": {
              "enum": ["on", "off"],
              "description": "default on"
            },
            "url": {
              "type": "string",
              "description": "answers an HTTP GET when the network is up; default https://api.github.com/zen"
            },
            "command": {
              "$ref": "#/$defs/argv"
            },
            "timeout": {
              "$ref": "#/$defs/duration"
            }
          }
        },
        "tick_timeout": {
          "$ref": "#/$defs/duration",
          "description": "time budget for one check's optional work (fallback probes); default 3m, minimum 30s"
        },
        "daemon": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "interval": {
              "$ref": "#/$defs/duration"
            },
            "control_poll": {
              "$ref": "#/$defs/duration"
            }
          }
        },
        "switch_back": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "min_after": {
              "$ref": "#/$defs/duration"
            },
            "retry_every": {
              "$ref": "#/$defs/duration"
            }
          },
          "description": "return to the primary after a handoff once its limit resets and an exact probe passes"
        },
        "probe": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "claude",
                "codex",
                "command"
              ]
            },
            "model": {
              "type": "string",
              "description": "cheap model for scheduled probes"
            },
            "command": {
              "$ref": "#/$defs/argv"
            },
            "exit_codes": {
              "type": "object",
              "patternProperties": {
                "^[0-9]+$": {
                  "enum": [
                    "none",
                    "rate_limit",
                    "auth",
                    "overloaded",
                    "network",
                    "unknown"
                  ]
                }
              },
              "additionalProperties": false
            },
            "cli": {
              "type": "string"
            },
            "workdir": {
              "type": "string"
            },
            "env": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "description": "extra environment for the probe, for example CLAUDE_CONFIG_DIR or CODEX_HOME to check another account's login"
            }
          }
        },
        "cursor": {
          "$ref": "#/$defs/cursor"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "adapter": {
                "const": "cursor"
              }
            }
          },
          "then": {
            "required": [
              "cursor"
            ],
            "properties": {
              "fallbacks": {
                "const": ""
              },
              "switch_back": {
                "properties": {
                  "enabled": {
                    "const": false
                  }
                }
              }
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "duration": {
      "type": "string",
      "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$",
      "description": "Go duration such as 30s, 10m, 4h"
    },
    "argv": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "bb": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "thread"
      ],
      "properties": {
        "thread": {
          "type": "string",
          "description": "BB thread id"
        },
        "cli": {
          "type": "string",
          "default": "bb"
        },
        "model": {
          "type": "string",
          "description": "applied with bb thread update before the first message after a handoff"
        },
        "reasoning": {
          "type": "string"
        },
        "retry_signal_ttl": {
          "$ref": "#/$defs/duration",
          "description": "how long a provider retry notice on an errored thread suppresses error recovery; default 15m, minimum 1m"
        }
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status_command",
        "resume_command"
      ],
      "properties": {
        "status_command": {
          "$ref": "#/$defs/argv"
        },
        "resume_command": {
          "$ref": "#/$defs/argv"
        },
        "stop_command": {
          "$ref": "#/$defs/argv"
        },
        "exit_codes": {
          "type": "object",
          "patternProperties": {
            "^[0-9]+$": {
              "enum": [
                "none",
                "rate_limit",
                "auth",
                "overloaded",
                "network",
                "unknown"
              ]
            }
          },
          "additionalProperties": false
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "timeout": {
          "$ref": "#/$defs/duration"
        }
      }
    },
    "claude": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workdir"
      ],
      "properties": {
        "cli": {
          "type": "string",
          "default": "claude"
        },
        "workdir": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "effort": {
          "type": "string"
        },
        "permission_mode": {
          "type": "string"
        },
        "max_budget_usd": {
          "type": "number",
          "minimum": 0
        },
        "extra_args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Environment overrides for turns and inherited by probes. Values are literal; use absolute account configuration paths."
        }
      }
    },
    "codex": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workdir"
      ],
      "properties": {
        "cli": {
          "type": "string",
          "default": "codex"
        },
        "workdir": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "sandbox": {
          "type": "string"
        },
        "skip_git_repo_check": {
          "type": "boolean"
        },
        "extra_args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Environment overrides for turns and inherited by probes. Values are literal; use absolute account configuration paths."
        }
      }
    },
    "cursor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workdir"
      ],
      "properties": {
        "cli": {
          "type": "string",
          "default": "agent"
        },
        "workdir": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  }
}
