{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/connorburgess/keepgoing-agents/schema/fallbacks.schema.json",
  "title": "fallbacks.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "candidates"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "redundancy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min_healthy": {
          "type": "integer",
          "minimum": 0
        },
        "span": {
          "enum": [
            "provider",
            "group",
            "none"
          ]
        }
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "every": {
          "$ref": "#/$defs/duration"
        },
        "ttl": {
          "$ref": "#/$defs/duration"
        },
        "daily_cap": {
          "type": "integer",
          "minimum": 0
        },
        "timeout": {
          "$ref": "#/$defs/duration"
        },
        "scheduled_disabled": {
          "type": "boolean"
        }
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "adapter",
          "provider"
        ],
        "properties": {
          "adapter": {
            "enum": [
              "bb",
              "process",
              "claude",
              "codex",
              "custom",
              "acp"
            ]
          },
          "provider": {
            "type": "string",
            "description": "claude-code, codex, or any label; redundancy counts by it"
          },
          "group": {
            "type": "string",
            "description": "account or quota pool; defaults to provider"
          },
          "bb": {
            "$ref": "#/$defs/bb"
          },
          "process": {
            "$ref": "#/$defs/process"
          },
          "claude": {
            "$ref": "#/$defs/claude"
          },
          "codex": {
            "$ref": "#/$defs/codex"
          },
          "cursor": false,
          "custom": {
            "$ref": "#/$defs/custom"
          },
          "acp": {
            "$ref": "#/$defs/acp"
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
            "not": {
              "const": "primary"
            }
          },
          "disabled": {
            "type": "boolean"
          },
          "probe": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "claude",
                  "codex",
                  "custom",
                  "command"
                ]
              },
              "model": {
                "type": "string",
                "description": "cheap model for scheduled probes"
              },
              "command": {
                "$ref": "#/$defs/argv"
              },
              "exit_codes": {
                "type": "object",
                "patternProperties": {
                  "^[0-9]+$": {
                    "enum": [
                      "none",
                      "rate_limit",
                      "auth",
                      "overloaded",
                      "network",
                      "unknown"
                    ]
                  }
                },
                "additionalProperties": false
              },
              "cli": {
                "type": "string"
              },
              "workdir": {
                "type": "string"
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "extra environment for the probe, for example CLAUDE_CONFIG_DIR or CODEX_HOME to check another account's login"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "duration": {
      "type": "string",
      "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$",
      "description": "Go duration such as 30s, 10m, 4h"
    },
    "argv": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "bb": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        {
          "required": ["thread"],
          "not": {"anyOf": [{"required": ["new_thread"]}, {"required": ["project"]}, {"required": ["environment"]}, {"required": ["permission_mode"]}]}
        },
        {
          "required": ["new_thread"],
          "properties": {"new_thread": {"const": true}},
          "not": {"required": ["thread"]}
        }
      ],
      "properties": {
        "thread": {
          "type": "string",
          "description": "existing BB thread id"
        },
        "new_thread": {
          "type": "boolean",
          "description": "instead of thread: at handoff, create a new BB thread on this candidate's provider and model. Opt-in; the only case in which keepgoing creates a thread. Requires provider."
        },
        "project": {
          "type": "string",
          "description": "with new_thread: BB project for the new thread; default is the project of the conversation it continues"
        },
        "environment": {
          "type": "string",
          "description": "with new_thread: existing BB environment for the new thread; default is the environment of the conversation it continues"
        },
        "permission_mode": {
          "enum": ["accept-edits", "auto", "full"],
          "default": "accept-edits",
          "description": "with new_thread: the new thread's permission mode, always passed to BB so it never inherits a project default"
        },
        "cli": {
          "type": "string",
          "default": "bb"
        },
        "model": {
          "type": "string",
          "description": "applied with bb thread update before the first message after a handoff"
        },
        "reasoning": {
          "type": "string"
        },
        "retry_signal_ttl": {
          "$ref": "#/$defs/duration",
          "description": "how long a provider retry notice on an errored thread suppresses error recovery; default 15m, minimum 1m"
        }
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status_command",
        "resume_command"
      ],
      "properties": {
        "status_command": {
          "$ref": "#/$defs/argv"
        },
        "resume_command": {
          "$ref": "#/$defs/argv"
        },
        "stop_command": {
          "$ref": "#/$defs/argv"
        },
        "exit_codes": {
          "type": "object",
          "patternProperties": {
            "^[0-9]+$": {
              "enum": [
                "none",
                "rate_limit",
                "auth",
                "overloaded",
                "network",
                "unknown"
              ]
            }
          },
          "additionalProperties": false
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "timeout": {
          "$ref": "#/$defs/duration"
        }
      }
    },
    "claude": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workdir"
      ],
      "properties": {
        "cli": {
          "type": "string",
          "default": "claude"
        },
        "workdir": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "effort": {
          "type": "string"
        },
        "permission_mode": {
          "type": "string"
        },
        "max_budget_usd": {
          "type": "number",
          "minimum": 0
        },
        "extra_args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Environment overrides for turns and inherited by probes. Values are literal; use absolute account configuration paths."
        }
      }
    },
    "codex": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workdir"
      ],
      "properties": {
        "cli": {
          "type": "string",
          "default": "codex"
        },
        "workdir": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "sandbox": {
          "type": "string"
        },
        "skip_git_repo_check": {
          "type": "boolean"
        },
        "extra_args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Environment overrides for turns and inherited by probes. Values are literal; use absolute account configuration paths."
        }
      }
    },
    "custom": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "workdir",
        "definition"
      ],
      "description": "an agent defined in configuration, run one turn per process; unreleased source",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,31}$",
          "description": "label for the agent; the provider when none is set"
        },
        "workdir": {
          "type": "string"
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "values": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "maxLength": 256
          },
          "description": "this loop's values for the settings the definition accepts"
        },
        "definition": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start",
            "output"
          ],
          "properties": {
            "settings": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,31}$"
              },
              "description": "setting names the commands may refer to as {name}"
            },
            "start": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "description": "argv, run without a shell. An item is one argument, or a list of arguments left out together when a setting they refer to as {name} has no value",
              "items": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    }
                  }
                ]
              }
            },
            "resume": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "description": "argv to continue a session; refers to {session}. Needs session and capabilities.exact_resume",
              "items": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    }
                  }
                ]
              }
            },
            "prompt": {
              "enum": [
                "stdin",
                "file"
              ],
              "default": "stdin",
              "description": "how a turn receives its prompt; with file the commands refer to {prompt_file}. A prompt is never an argument"
            },
            "output": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "format"
              ],
              "properties": {
                "format": {
                  "enum": [
                    "json",
                    "jsonl"
                  ]
                },
                "max_bytes": {
                  "type": "integer",
                  "minimum": 1024,
                  "maximum": 16777216,
                  "default": 1048576,
                  "description": "larger output is not read"
                },
                "select": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "field",
                    "equals"
                  ],
                  "properties": {
                    "field": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_]{1,64}(\\.[A-Za-z0-9_]{1,64}){0,7}$",
                      "description": "a JSON field, names joined by dots"
                    },
                    "equals": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_.:-]{1,64}$",
                      "description": "a code; free text is never compared"
                    }
                  },
                  "description": "read the last object whose field has this value; without it, the last object"
                }
              }
            },
            "session": {
              "type": "object",
              "additionalProperties": false,
              "description": "where the session identity comes from: a field of the output, or a file under the working directory",
              "properties": {
                "field": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_]{1,64}(\\.[A-Za-z0-9_]{1,64}){0,7}$",
                  "description": "a JSON field, names joined by dots"
                },
                "select": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "field",
                    "equals"
                  ],
                  "properties": {
                    "field": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_]{1,64}(\\.[A-Za-z0-9_]{1,64}){0,7}$",
                      "description": "a JSON field, names joined by dots"
                    },
                    "equals": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_.:-]{1,64}$",
                      "description": "a code; free text is never compared"
                    }
                  }
                },
                "file": {
                  "type": "string"
                }
              }
            },
            "finished": {
              "type": "object",
              "additionalProperties": false,
              "description": "the turn ended healthy; defaults to exit code 0",
              "properties": {
                "exit_codes": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 255
                  }
                },
                "field": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_]{1,64}(\\.[A-Za-z0-9_]{1,64}){0,7}$",
                  "description": "a JSON field, names joined by dots"
                },
                "equals": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.:-]{1,64}$",
                    "description": "a code; free text is never compared"
                  }
                }
              }
            },
            "waiting": {
              "type": "object",
              "additionalProperties": false,
              "description": "the turn ended waiting on a person; needs capabilities.structured_waiting",
              "properties": {
                "exit_codes": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 255
                  }
                },
                "field": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_]{1,64}(\\.[A-Za-z0-9_]{1,64}){0,7}$",
                  "description": "a JSON field, names joined by dots"
                },
                "equals": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.:-]{1,64}$",
                    "description": "a code; free text is never compared"
                  }
                }
              }
            },
            "errors": {
              "type": "object",
              "additionalProperties": false,
              "description": "classify a failed turn; needs capabilities.structured_errors. Anything unmatched is unknown",
              "properties": {
                "field": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_]{1,64}(\\.[A-Za-z0-9_]{1,64}){0,7}$",
                  "description": "a JSON field, names joined by dots"
                },
                "classes": {
                  "type": "object",
                  "additionalProperties": {
                    "enum": [
                      "rate_limit",
                      "auth",
                      "overloaded",
                      "network",
                      "unknown"
                    ]
                  },
                  "description": "the agent's own codes mapped to error classes"
                },
                "http_status_field": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_]{1,64}(\\.[A-Za-z0-9_]{1,64}){0,7}$",
                  "description": "a JSON field, names joined by dots"
                },
                "exit_codes": {
                  "type": "object",
                  "patternProperties": {
                    "^[0-9]+$": {
                      "enum": [
                        "rate_limit",
                        "auth",
                        "overloaded",
                        "network",
                        "unknown"
                      ]
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "probe": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "argv"
              ],
              "description": "a small real request, judged by the finished and errors rules; lets the agent be a fallback",
              "properties": {
                "argv": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 64,
                  "description": "argv, run without a shell. An item is one argument, or a list of arguments left out together when a setting they refer to as {name} has no value",
                  "items": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "string"
                        }
                      }
                    ]
                  }
                }
              }
            },
            "limits": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "argv",
                "blocked"
              ],
              "description": "asks the agent whether its account is blocked by a usage limit; run only for an unclassified failure",
              "properties": {
                "argv": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 64,
                  "description": "argv, run without a shell. An item is one argument, or a list of arguments left out together when a setting they refer to as {name} has no value",
                  "items": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "string"
                        }
                      }
                    ]
                  }
                },
                "blocked": {
                  "type": "object",
                  "additionalProperties": false,
                  "description": "the account is blocked; read from a field",
                  "properties": {
                    "exit_codes": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 255
                      }
                    },
                    "field": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_]{1,64}(\\.[A-Za-z0-9_]{1,64}){0,7}$",
                      "description": "a JSON field, names joined by dots"
                    },
                    "equals": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9_.:-]{1,64}$",
                        "description": "a code; free text is never compared"
                      }
                    }
                  }
                },
                "resets_at_field": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_]{1,64}(\\.[A-Za-z0-9_]{1,64}){0,7}$",
                  "description": "a JSON field, names joined by dots"
                }
              }
            },
            "capabilities": {
              "type": "object",
              "additionalProperties": false,
              "description": "each must be backed by the rule that lets keepgoing observe it; anything undeclared is unknown",
              "properties": {
                "exact_resume": {
                  "type": "boolean"
                },
                "can_be_stopped": {
                  "type": "boolean"
                },
                "structured_errors": {
                  "type": "boolean"
                },
                "structured_waiting": {
                  "type": "boolean"
                },
                "retries_itself": {
                  "const": false
                },
                "fails_over_itself": {
                  "const": false
                },
                "schedules_itself": {
                  "const": false
                },
                "child_work": {
                  "const": false
                }
              }
            }
          }
        }
      }
    },
    "acp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "command",
        "workdir"
      ],
      "description": "an agent reached over the Agent Client Protocol (ACP v1) on its standard streams; unreleased source",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,31}$",
          "description": "label for the agent; the provider when none is set"
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "description": "the agent's ACP server command as argv, run without a shell"
        },
        "workdir": {
          "type": "string"
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "handshake_timeout": {
          "$ref": "#/$defs/duration",
          "description": "bounds initialization and session setup; default 2m, at most 10m"
        },
        "exit_timeout": {
          "$ref": "#/$defs/duration",
          "description": "bounds the wait for the agent to exit after its turn; default 10s, at most 10m"
        }
      }
    }
  }
}
